#!/bin/sh
# thin-edge.io log plugin: file
#
# Implements the thin-edge.io log plugin interface:
#   list              - Lists all log types (one per line, from tedge-log-plugin.toml)
#   get <type> [--since <seconds>] [--until <seconds>]
#                     - Retrieves log content for the given type
#
# See: https://thin-edge.github.io/thin-edge.io/extend/log-management/
#
# Delegates to the built-in tedge-file-log-plugin (multicall binary).
# The snap runs as root, so sudo.enable must be false (set via install hook).

set -eu

# Determine the tedge-file-log-plugin binary and config directory.
# IMPORTANT: must be called as its own binary (not as 'tedge tedge-file-log-plugin')
# so that the clap multicall mechanism dispatches via argv[0].
if [ -n "${SNAP:-}" ] && [ -x "${SNAP}/bin/tedge-file-log-plugin" ]; then
    PLUGIN_BIN="${SNAP}/bin/tedge-file-log-plugin"
    CONFIG_DIR="${SNAP_DATA:-/var/snap/${SNAP_INSTANCE_NAME:-ctrlx-cumulocity-thin-edge-io}/current}/tedge"
else
    # Fallback: derive snap root from /proc/mounts bind-mount of this directory
    SNAP_ROOT=""
    if [ -r /proc/mounts ]; then
        SNAP_ROOT=$(awk '$2 == "/usr/share/tedge/log-plugins" { print $1 }' /proc/mounts \
            | sed 's|/var/snap/\([^/]*\)/.*|\1|' \
            | head -1)
        SNAP_ROOT="/snap/${SNAP_ROOT}/current"
    fi
    if [ -n "$SNAP_ROOT" ] && [ -x "${SNAP_ROOT}/bin/tedge-file-log-plugin" ]; then
        PLUGIN_BIN="${SNAP_ROOT}/bin/tedge-file-log-plugin"
        CONFIG_DIR="/var/snap/${SNAP_INSTANCE_NAME:-ctrlx-cumulocity-thin-edge-io}/current/tedge"
    else
        # Last resort: system installation
        PLUGIN_BIN=$(command -v tedge-file-log-plugin 2>/dev/null || echo "tedge-file-log-plugin")
        CONFIG_DIR="/etc/tedge"
    fi
fi

exec "$PLUGIN_BIN" --config-dir "$CONFIG_DIR" "$@"
