{
  "id": "thin-edge-io",
  "ports": [
    {
      "number": 1883,
      "application-protocol": "MQTT",
      "service-name": "thin-edge-io",
      "purpose": "Local MQTT broker bound to 127.0.0.1 only, not externally accessible",
      "binding": "localhost",
      "routing": "internal",
      "default-state": "open"
    },
    {
      "number": 8888,
      "application-protocol": "HTTP",
      "service-name": "thin-edge-io",
      "purpose": "Configuration Web UI bound to 127.0.0.1, proxied via ctrlX reverse proxy",
      "binding": "localhost",
      "routing": "internal",
      "default-state": "open"
    },
    {
      "number": 8883,
      "application-protocol": "MQTT/TLS",
      "service-name": "thin-edge-io",
      "purpose": "Outbound MQTT over TLS connection to Cumulocity IoT cloud platform",
      "binding": "IP",
      "routing": "external",
      "default-state": "open"
    },
    {
      "number": 9883,
      "application-protocol": "MQTT/TLS",
      "service-name": "thin-edge-io",
      "purpose": "Outbound MQTT Service port to Cumulocity IoT cloud platform (optional)",
      "binding": "IP",
      "routing": "external",
      "default-state": "closed"
    },
    {
      "number": 443,
      "application-protocol": "HTTPS",
      "service-name": "thin-edge-io",
      "purpose": "Outbound HTTPS connections to cloud platform REST APIs",
      "binding": "IP",
      "routing": "external",
      "default-state": "open"
    }
  ]

}
