#!/bin/bash
# thin-edge.io snap post-refresh hook
# Runs after snap update/refresh

set -eo pipefail

echo "=== thin-edge.io snap post-refresh hook starting ===" >&2

# Ensure critical directories exist after update
echo "Running centralized directory setup..." >&2
bash "$SNAP/scripts/setup-directories.sh"

# Remove stale apt symlinks from older versions (snap plugin is recreated below).
rm -f "$SNAP_DATA/tedge/sm-plugins/apt" 2>/dev/null || true

# Regenerate snap inventory JSON.
# Tries 'snap list' first (works in hook context), falls back to reading
# /snap/*/current/meta/snap.yaml if snap list is not accessible.
echo "Regenerating snap inventory..." >&2

# Helper: build JSON entry
make_snap_entry() {
    local name="$1" version="$2" rev="$3"
    printf '{"name":"%s","version":"%s","url":"rev:%s","softwareType":"snap"}' \
        "$name" "$version" "$rev"
}

# Collect all snap entries into an array-style JSON
snap_entries=""

# In hook context, snap list is AppArmor-restricted to only showing the current snap.
# Use /snap/*/current/meta/snap.yaml to discover all installed snaps from the filesystem.
echo "Building snap inventory from /snap meta files..." >&2
snap_entries=$(make_snap_entry "$SNAP_NAME" "$SNAP_VERSION" "$SNAP_REVISION")
for yaml_file in /snap/*/current/meta/snap.yaml; do
    [ -f "$yaml_file" ] || continue
    name=$(grep '^name:' "$yaml_file" 2>/dev/null | head -1 | awk '{print $2}' | tr -d '"')
    version=$(grep '^version:' "$yaml_file" 2>/dev/null | head -1 | awk '{print $2}' | tr -d '"')
    [ -z "$name" ] && continue
    [ "$name" = "$SNAP_NAME" ] && continue  # skip ourselves — already added above
    snap_current_dir="${yaml_file%/meta/snap.yaml}"
    rev=$(readlink "$snap_current_dir" 2>/dev/null || echo "?")
    entry=$(make_snap_entry "$name" "$version" "$rev")
    snap_entries="${snap_entries},${entry}"
done

snap_json="[${snap_entries}]"
echo "$snap_json" > "$SNAP_DATA/snap-inventory.json"
chmod 644 "$SNAP_DATA/snap-inventory.json"
echo "Snap inventory written: $(echo "$snap_json" | grep -o 'softwareType' | wc -l) entries" >&2

# Create snap sm-plugin so tedge-agent can answer software_list requests from C8y.
# snap list is AppArmor-blocked in strict confinement — use env vars directly.
# Layout: /usr/share/tedge/sm-plugins -> $SNAP_DATA/tedge/sm-plugins
echo "Creating snap sm-plugin..." >&2
cat > "$SNAP_DATA/tedge/sm-plugins/snap" << 'PLUGIN_EOF'
#!/bin/bash
# sm-plugin for snap packages on ctrlX CORE
# Uses /run/snapd-snap.socket (accessible to all strictly confined snaps by default,
# no snapd-control needed) via Python3 to query GET /v2/snaps.
# Falls back to snap list (requires snapd-control) and finally to own snap only.
# tedge sm-plugin format: name<TAB>version<TAB>type<TAB>url
case "$1" in
  list)
    # Method 1: snapd snap socket via Python3 — no extra interface needed
    if result=$(python3 - 2>/dev/null << 'PYEOF'
import socket, json, sys
try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(5)
    sock.connect('/run/snapd-snap.socket')
    sock.sendall(b'GET /v2/snaps HTTP/1.0\r\nHost: localhost\r\n\r\n')
    data = b''
    while True:
        chunk = sock.recv(8192)
        if not chunk:
            break
        data += chunk
    sock.close()
    body = data.split(b'\r\n\r\n', 1)[-1]
    result = json.loads(body)
    for snap in result.get('result', []):
        name = snap.get('name', '')
        version = snap.get('version', '')
        revision = snap.get('revision', '')
        if name:
            print(f'{name}\t{version}\tsnap\trev:{revision}')
except Exception as e:
    sys.exit(1)
PYEOF
    ) && [ -n "$result" ]; then
      echo "$result"
      exit 0
    fi

    # Method 2: snap list (requires snapd-control interface to be connected)
    if snap_output=$(snap list --unicode=never --color=never 2>/dev/null) && [ -n "$snap_output" ]; then
      echo "$snap_output" | awk 'NR>1 && $1 != "" { printf "%s\t%s\tsnap\trev:%s\n", $1, $2, $3 }'
      exit 0
    fi

    # Method 3: last resort — report only this snap
    printf '%s\t%s\tsnap\trev:%s\n' "$SNAP_NAME" "$SNAP_VERSION" "$SNAP_REVISION"
    ;;
  install|remove)
    echo "snap install/remove not supported on ctrlX CORE (strict confinement)" >&2
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
PLUGIN_EOF
chmod +x "$SNAP_DATA/tedge/sm-plugins/snap"
echo "snap sm-plugin created" >&2

# Create symlink from SNAP_DATA to SNAP_COMMON lock directory
echo "Creating symlink for lock directory..." >&2
if [ -d "$SNAP_DATA/tedge/run/lock" ] && [ ! -L "$SNAP_DATA/tedge/run/lock" ]; then
  rmdir "$SNAP_DATA/tedge/run/lock" 2>/dev/null || rm -rf "$SNAP_DATA/tedge/run/lock"
else
  rm -f "$SNAP_DATA/tedge/run/lock"
fi
ln -sf "$SNAP_COMMON/tedge/run/lock" "$SNAP_DATA/tedge/run/lock"

# Update revision-specific paths that were set during install but become stale after updates
echo "Updating revision-specific tedge config paths..." >&2
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set run.path "$SNAP_DATA/tedge/run" 2>/dev/null || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set tmp.path "$SNAP_DATA/tedge/tmp" 2>/dev/null || true

# Fix hardcoded revision paths in mosquitto bridge configs.
# tedge connect writes absolute paths like /var/snap/thin-edge-io/x42/...
# After a snap update the revision changes, making cert/key paths invalid.
# Replace all revision-specific paths with the stable "current" symlink.
echo "Fixing revision paths in mosquitto bridge configs..." >&2
MOSQUITTO_CONF_DIR="$SNAP_DATA/tedge/mosquitto-conf"
SNAP_BASE="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}"
if [ -d "$MOSQUITTO_CONF_DIR" ]; then
    for f in "$MOSQUITTO_CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        if grep -qE "${SNAP_BASE}/x[0-9]+" "$f" 2>/dev/null; then
            sed -i -E "s|${SNAP_BASE}/x[0-9]+/|${SNAP_BASE}/current/|g" "$f"
            echo "  Fixed revision paths in: $(basename "$f")" >&2
        fi
    done
fi

# =========================================================================
# --- CRITICAL FIX: Repariere Plugin-Konfigurationen nach Update ---
# =========================================================================
echo "Regenerating stable plugin configurations..." >&2
STABLE_CURRENT="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}/current"
STABLE_COMMON="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}/common"

# Stelle sicher, dass inventory.json auch beim Update existiert, falls gelöscht
if [ ! -f "$STABLE_COMMON/tedge/device/inventory.json" ]; then
cat <<EOF > "$STABLE_COMMON/tedge/device/inventory.json"
{
  "c8y_Hardware": {
    "model": "Bosch ctrlX CORE",
    "serialNumber": "auto-detected",
    "revision": "1.0"
  }
}
EOF
fi

cat <<EOF > "$SNAP_DATA/tedge/plugins/tedge-log-plugin.toml"
[[files]]
type = "software-management"
path = "${STABLE_COMMON}/tedge/log/agent/workflow-software_*"

[[files]]
type = "tedge-agent"
path = "${STABLE_COMMON}/tedge/log/tedge-agent.log"

[[files]]
type = "tedge-datalayer-bridge"
path = "${STABLE_COMMON}/tedge/log/tedge-datalayer-bridge.log"

[[files]]
type = "tedge-mapper-c8y"
path = "${STABLE_COMMON}/tedge/log/tedge-mapper.log"

[[files]]
type = "mosquitto"
path = "${STABLE_COMMON}/tedge/log/mosquitto.log"

[[files]]
type = "webserver"
path = "${STABLE_COMMON}/tedge/log/tedge-web-config.log"

[[files]]
type = "log-upload-manager"
path = "${STABLE_COMMON}/tedge/log/tedge-log-upload-manager.log"
EOF

cat <<EOF > "$SNAP_DATA/tedge/plugins/tedge-configuration-plugin.toml"
[[files]]
path = "${STABLE_CURRENT}/tedge/tedge.toml"
type = "tedge.toml"

[[files]]
path = "${STABLE_CURRENT}/tedge/tedge.toml"
type = "default"

[[files]]
path = "${STABLE_CURRENT}/mosquitto/mosquitto.conf"
type = "mosquitto.conf"

[[files]]
path = "${STABLE_COMMON}/tedge/device/inventory.json"
type = "inventory.json"

[[files]]
path = "${STABLE_CURRENT}/tedge/plugins/tedge-log-plugin.toml"
type = "tedge-log-plugin"
EOF

chmod 644 "$SNAP_DATA/tedge/plugins/tedge-configuration-plugin.toml"
chmod 644 "$SNAP_DATA/tedge/plugins/tedge-log-plugin.toml"
chmod 644 "$STABLE_COMMON/tedge/device/inventory.json"

# =========================================================================
# Korrigiere stale data.path und sudo.enable nach Update
# =========================================================================
echo "Correcting stale tedge config values after update..." >&2
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set data.path "$SNAP_COMMON/tedge" 2>&1 | tee -a /tmp/post-refresh.log >&2 || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set logs.path "$SNAP_COMMON/tedge/log" 2>&1 | tee -a /tmp/post-refresh.log >&2 || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set sudo.enable false 2>&1 | tee -a /tmp/post-refresh.log >&2 || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set mqtt.client.port 1883 2>&1 | tee -a /tmp/post-refresh.log >&2 || true
# log.plugin_paths: leeres Verzeichnis — tedge-agent's eingebauter LogManager wird deaktiviert.
# Log-Uploads übernimmt unser tedge-log-upload-manager (Rust) direkt via MQTT.
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set log.plugin_paths "$SNAP_DATA/tedge/log-plugins-disabled" 2>&1 | tee -a /tmp/post-refresh.log >&2 || true


# =========================================================================
# Inventory mit echten Systemdaten befüllen
# =========================================================================
if [ -f "$SNAP/scripts/update-inventory.sh" ]; then
    echo "Running inventory update script..." >&2
    "$SNAP/scripts/update-inventory.sh" 2>&1 || true
fi
# =========================================================================

echo "Post-refresh hook completed successfully" >&2

# Clear retained health topics of removed services so they disappear from Cumulocity.
# An empty retained payload deletes the retained message on the broker.
MQTT_PUB="$SNAP/usr/bin/mosquitto_pub"
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
echo "Clearing stale service health topics..." >&2
for stale_svc in "tedge-log-plugin" "c8y-firmware-plugin" "tedge-file-log-plugin"; do
    "$MQTT_PUB" -h "$MQTT_HOST" -p "$MQTT_PORT" \
        -r -t "te/device/main/service/${stale_svc}/status/health" -m "" \
        2>/dev/null || true
done

# Re-connect snap interfaces after update
snapctl connect :hardware-observe 2>/dev/null || true
snapctl connect :log-observe 2>/dev/null || true
snapctl connect :snapd-control 2>/dev/null || true