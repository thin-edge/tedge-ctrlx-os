#!/bin/bash
# thin-edge.io snap post-refresh hook
# Runs after snap update/refresh

set -eo pipefail

# ── Persistent hook log (SNAP_COMMON survives snap revisions, readable on device) ──
# Guard: skip if already set up by a parent hook (e.g. install calls post-refresh)
if [ -z "$_SNAP_HOOK_LOG_ACTIVE" ]; then
    _HOOK_LOG="${SNAP_COMMON}/tedge/log/snap-hooks.log"
    mkdir -p "$(dirname "$_HOOK_LOG")" 2>/dev/null || true
    # Rotate when > 1 MB
    if [ -f "$_HOOK_LOG" ] && [ "$(stat -c%s "$_HOOK_LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
        mv "$_HOOK_LOG" "${_HOOK_LOG}.1" 2>/dev/null || true
    fi
    exec > >(tee -a "$_HOOK_LOG") 2>&1
    export _SNAP_HOOK_LOG_ACTIVE=1
fi
echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) [post-refresh] snap=${SNAP_NAME} version=${SNAP_VERSION} rev=${SNAP_REVISION} ==="

echo "=== thin-edge.io snap post-refresh hook starting ==="

# Ensure tedge system user exists (may be missing after OS update or first install fallback)
if ! id "tedge" &>/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin tedge 2>/dev/null && \
        echo "Created tedge system user" || \
        echo "WARNING: Could not create tedge user (non-fatal)"
fi

# Ensure critical directories exist after update
echo "Running centralized directory setup..." >&2
bash "$SNAP/scripts/setup-directories.sh"

# Remove stale apt symlinks from older versions (snap plugin is recreated below).
rm -f "$SNAP_DATA/tedge/sm-plugins/apt" 2>/dev/null || true

# Regenerate snap inventory JSON.
# Priority: 1) snap list (requires snapd-control, works if connected)
#           2) /snap/*/current/meta/snap.yaml scan (works in hook AppArmor profile)
#           3) env vars only (always works, current snap only)
echo "Regenerating snap inventory..." >&2

snap_json=$(python3 - <<'INNER_EOF' 2>/dev/null
import subprocess, json, os, glob

def via_snap_list():
    try:
        out = subprocess.check_output(
            ["snap", "list", "--json"],
            stderr=subprocess.DEVNULL,
            timeout=10
        )
        data = json.loads(out)
        snaps = data if isinstance(data, list) else data.get("snaps", [])
        if not snaps:
            return None
        result = []
        for sn in snaps:
            name = sn.get("name", "")
            if not name:
                continue
            result.append({
                "name": name,
                "version": sn.get("version", "?"),
                "url": "rev:" + str(sn.get("revision", "?")),
                "softwareType": "snap"
            })
        return result if result else None
    except Exception:
        return None

def via_yaml_scan():
    entries = []
    for yaml_file in glob.glob("/snap/*/current/meta/snap.yaml"):
        try:
            name = version = None
            with open(yaml_file) as f:
                for line in f:
                    if line.startswith("name:") and name is None:
                        name = line.split(":", 1)[1].strip().strip('"')
                    elif line.startswith("version:") and version is None:
                        version = line.split(":", 1)[1].strip().strip('"')
            if name:
                snap_dir = yaml_file.replace("/meta/snap.yaml", "")
                try:
                    rev = os.path.basename(os.readlink(snap_dir))
                except Exception:
                    rev = "?"
                entries.append({
                    "name": name,
                    "version": version or "?",
                    "url": f"rev:{rev}",
                    "softwareType": "snap"
                })
        except Exception:
            continue
    return entries if entries else None

def via_env():
    name = os.environ.get("SNAP_NAME", "")
    if not name:
        return []
    return [{
        "name": name,
        "version": os.environ.get("SNAP_VERSION", "?"),
        "url": "rev:" + os.environ.get("SNAP_REVISION", "?"),
        "softwareType": "snap"
    }]

result = via_snap_list() or via_yaml_scan() or via_env()
print(json.dumps(result))
INNER_EOF
)

# Fallback if Python3 failed completely
if [ -z "$snap_json" ] || [ "$snap_json" = "[]" ]; then
    snap_json=$(printf '[{"name":"%s","version":"%s","url":"rev:%s","softwareType":"snap"}]' \
        "$SNAP_NAME" "$SNAP_VERSION" "$SNAP_REVISION")
fi

echo "$snap_json" > "$SNAP_DATA/snap-inventory.json"
chmod 644 "$SNAP_DATA/snap-inventory.json"
entry_count=$(echo "$snap_json" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo "?")
echo "Snap inventory written: $entry_count entries" >&2

# Immediately publish the new inventory to MQTT so C8y reflects changes without
# waiting for the hourly log_upload_manager cycle.
# mosquitto_pub is bundled in the snap — simpler and more reliable than tedge mqtt pub
# during refresh (no connection retry, no signal risk). || true = never fail hook.
"$SNAP/usr/bin/mosquitto_pub" \
    -h 127.0.0.1 -p 1883 -r \
    -t "te/device/main///twin/c8y_SoftwareList" \
    -m "$snap_json" 2>/dev/null || true
echo "Published c8y_SoftwareList to MQTT ($entry_count entries)" >&2

# Create snap sm-plugin so tedge-agent can answer software_list requests from C8y.
# snap list is AppArmor-blocked in strict confinement — use env vars directly.
# Layout: /usr/share/tedge/sm-plugins -> $SNAP_DATA/tedge/sm-plugins
echo "Creating snap sm-plugin..." >&2
cat > "$SNAP_DATA/tedge/sm-plugins/snap" << 'PLUGIN_EOF'
#!/bin/bash
# sm-plugin for snap packages on ctrlX CORE
# Uses /run/snapd-snap.socket (accessible to all strictly confined snaps by default,
# no snapd-control needed) via Python3 to query GET /v2/snaps.
# Falls back to snap list (requires snapd-control) and finally to own snap only.
# tedge sm-plugin format: name<TAB>version<TAB>type<TAB>url
case "$1" in
  list)
    # Method 1: snapd snap socket via Python3 — no extra interface needed
    if result=$(python3 - 2>/dev/null << 'PYEOF'
import socket, json, sys
try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(5)
    sock.connect('/run/snapd-snap.socket')
    sock.sendall(b'GET /v2/snaps HTTP/1.0\r\nHost: localhost\r\n\r\n')
    data = b''
    while True:
        chunk = sock.recv(8192)
        if not chunk:
            break
        data += chunk
    sock.close()
    body = data.split(b'\r\n\r\n', 1)[-1]
    result = json.loads(body)
    for snap in result.get('result', []):
        name = snap.get('name', '')
        version = snap.get('version', '')
        revision = snap.get('revision', '')
        if name:
            print(f'{name}\t{version}\tsnap\trev:{revision}')
except Exception as e:
    sys.exit(1)
PYEOF
    ) && [ -n "$result" ]; then
      echo "$result"
      exit 0
    fi

    # Method 2: snap list (requires snapd-control interface to be connected)
    if snap_output=$(snap list --unicode=never --color=never 2>/dev/null) && [ -n "$snap_output" ]; then
      echo "$snap_output" | awk 'NR>1 && $1 != "" { printf "%s\t%s\tsnap\trev:%s\n", $1, $2, $3 }'
      exit 0
    fi

    # Method 3: last resort — report only this snap
    printf '%s\t%s\tsnap\trev:%s\n' "$SNAP_NAME" "$SNAP_VERSION" "$SNAP_REVISION"
    ;;
  install|remove)
    echo "snap install/remove not supported on ctrlX CORE (strict confinement)" >&2
    exit 1
    ;;
  *)
    exit 0
    ;;
esac
PLUGIN_EOF
chmod +x "$SNAP_DATA/tedge/sm-plugins/snap"
echo "snap sm-plugin created" >&2

# Create symlink from SNAP_DATA to SNAP_COMMON lock directory
echo "Creating symlink for lock directory..." >&2
if [ -d "$SNAP_DATA/tedge/run/lock" ] && [ ! -L "$SNAP_DATA/tedge/run/lock" ]; then
  rmdir "$SNAP_DATA/tedge/run/lock" 2>/dev/null || rm -rf "$SNAP_DATA/tedge/run/lock"
else
  rm -f "$SNAP_DATA/tedge/run/lock"
fi
ln -sf "$SNAP_COMMON/tedge/run/lock" "$SNAP_DATA/tedge/run/lock"

# Update revision-specific paths that were set during install but become stale after updates
echo "Updating revision-specific tedge config paths..." >&2
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set run.path "$SNAP_DATA/tedge/run" 2>/dev/null || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set tmp.path "$SNAP_DATA/tedge/tmp" 2>/dev/null || true

# Fix hardcoded revision paths in mosquitto bridge configs.
# tedge connect writes absolute paths like /var/snap/thin-edge-io/x42/...
# After a snap update the revision changes, making cert/key paths invalid.
# Replace all revision-specific paths with the stable "current" symlink.
echo "Fixing revision paths in mosquitto bridge configs..." >&2
MOSQUITTO_CONF_DIR="$SNAP_DATA/tedge/mosquitto-conf"
SNAP_BASE="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}"
if [ -d "$MOSQUITTO_CONF_DIR" ]; then
    for f in "$MOSQUITTO_CONF_DIR"/*.conf; do
        [ -f "$f" ] || continue
        if grep -qE "${SNAP_BASE}/x[0-9]+" "$f" 2>/dev/null; then
            sed -i -E "s|${SNAP_BASE}/x[0-9]+/|${SNAP_BASE}/current/|g" "$f"
            echo "  Fixed revision paths in: $(basename "$f")" >&2
        fi
    done
fi

# =========================================================================
# --- Migrate datalayer credentials to separate file (x2→x3 upgrade) ---
# =========================================================================
# In x3+ credentials (username/password/token) are stored in datalayer-credentials.json (0600).
# Older versions stored them inside datalayer-mappings.json. Migrate if needed.
CREDS_FILE="$SNAP_DATA/datalayer-credentials.json"
MAPPINGS_FILE="$SNAP_DATA/datalayer-mappings.json"
if [ ! -f "$CREDS_FILE" ] && [ -f "$MAPPINGS_FILE" ]; then
    echo "Migrating datalayer credentials from mappings file..." >&2
    python3 - <<MIGEOF 2>/dev/null || true
import json, os
mappings_path = os.environ.get("SNAP_DATA", "") + "/datalayer-mappings.json"
creds_path    = os.environ.get("SNAP_DATA", "") + "/datalayer-credentials.json"
try:
    with open(mappings_path) as f:
        data = json.load(f)
    creds = {}
    for key in ("username", "password", "token"):
        if data.get(key):
            creds[key] = data[key]
    if creds:
        with open(creds_path, "w") as f:
            json.dump(creds, f, indent=2)
        os.chmod(creds_path, 0o600)
        print(f"Migrated credentials: {list(creds.keys())}")
    else:
        print("No credentials found in mappings file to migrate")
except Exception as e:
    print(f"Migration error (non-fatal): {e}")
MIGEOF
fi

# =========================================================================
# --- CRITICAL FIX: Repariere Plugin-Konfigurationen nach Update ---
# =========================================================================
echo "Regenerating stable plugin configurations..." >&2
STABLE_CURRENT="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}/current"
STABLE_COMMON="/var/snap/${SNAP_INSTANCE_NAME:-thin-edge-io}/common"

# Stelle sicher, dass inventory.json auch beim Update existiert, falls gelöscht
if [ ! -f "$STABLE_COMMON/tedge/device/inventory.json" ]; then
cat <<EOF > "$STABLE_COMMON/tedge/device/inventory.json"
{
  "c8y_Hardware": {
    "model": "Bosch ctrlX CORE",
    "serialNumber": "auto-detected",
    "revision": "1.0"
  }
}
EOF
fi

cat <<EOF > "$SNAP_DATA/tedge/plugins/tedge-log-plugin.toml"
[[files]]
type = "software-management"
path = "${STABLE_COMMON}/tedge/log/agent/workflow-software_*"

[[files]]
type = "tedge-agent"
path = "${STABLE_COMMON}/tedge/log/tedge-agent.log"

[[files]]
type = "tedge-datalayer-bridge"
path = "${STABLE_COMMON}/tedge/log/tedge-datalayer-bridge.log"

[[files]]
type = "tedge-mapper-c8y"
path = "${STABLE_COMMON}/tedge/log/tedge-mapper.log"

[[files]]
type = "mosquitto"
path = "${STABLE_COMMON}/tedge/log/mosquitto.log"

[[files]]
type = "webserver"
path = "${STABLE_COMMON}/tedge/log/tedge-web-config.log"

[[files]]
type = "log-upload-manager"
path = "${STABLE_COMMON}/tedge/log/tedge-log-upload-manager.log"
EOF

cat <<EOF > "$SNAP_DATA/tedge/plugins/tedge-configuration-plugin.toml"
[[files]]
path = "${STABLE_CURRENT}/tedge/tedge.toml"
type = "tedge.toml"

[[files]]
path = "${STABLE_CURRENT}/tedge/tedge.toml"
type = "default"

[[files]]
path = "${STABLE_CURRENT}/mosquitto/mosquitto.conf"
type = "mosquitto.conf"

[[files]]
path = "${STABLE_COMMON}/tedge/device/inventory.json"
type = "inventory.json"

[[files]]
path = "${STABLE_CURRENT}/tedge/plugins/tedge-log-plugin.toml"
type = "tedge-log-plugin"
EOF

chmod 644 "$SNAP_DATA/tedge/plugins/tedge-configuration-plugin.toml"
chmod 644 "$SNAP_DATA/tedge/plugins/tedge-log-plugin.toml"
chmod 644 "$STABLE_COMMON/tedge/device/inventory.json"

# =========================================================================
# Korrigiere stale data.path und sudo.enable nach Update
# =========================================================================
echo "Correcting stale tedge config values after update..." >&2
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set data.path "$SNAP_COMMON/tedge" 2>/dev/null || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set logs.path "$SNAP_COMMON/tedge/log" 2>/dev/null || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set sudo.enable false 2>/dev/null || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set mqtt.client.port 1883 2>/dev/null || true


# =========================================================================
# Inventory mit echten Systemdaten befüllen
# =========================================================================
if [ -f "$SNAP/scripts/update-inventory.sh" ]; then
    echo "Running inventory update script..." >&2
    "$SNAP/scripts/update-inventory.sh" 2>&1 || true
fi

# =========================================================================
# Enforce mapper start/stop state from saved config.
# snapd restarts ALL Startup=enabled services on every snap update.
# We must re-apply the user's saved enabled/disabled preference here.
# =========================================================================
echo "Enforcing mapper states from saved config..." >&2
python3 - <<'ENFORCEEOF' 2>&1 || true
import json, subprocess, os, sys

snap_data = os.environ.get("SNAP_DATA", "")
snap_instance = os.environ.get("SNAP_INSTANCE_NAME", "thin-edge-io")
cfg_path = os.path.join(snap_data, "tedge-web-config.json")

try:
    with open(cfg_path) as f:
        cfg = json.load(f)
except Exception as e:
    print(f"  Cannot read config (non-fatal): {e}", file=sys.stderr)
    sys.exit(0)

# (service_config_key, url_field, snap_service_name)
mappers = [
    ("c8y", "c8y-url",    "tedge-mapper-c8y"),
    ("aws", "aws-url",    "tedge-mapper-aws"),
    ("az",  "azure-url",  "tedge-mapper-az"),
]

for cfg_key, url_field, svc in mappers:
    cloud = cfg.get(cfg_key, {})
    enabled = bool(cloud.get("enabled", False))
    url = (cloud.get(url_field) or "").strip()
    # Force disabled when no URL configured
    if not url:
        enabled = False
    full_svc = f"{snap_instance}.{svc}"
    if enabled:
        r = subprocess.run(["snapctl", "start", "--enable", full_svc], capture_output=True)
        state = "started"
    else:
        r = subprocess.run(["snapctl", "stop", "--disable", full_svc], capture_output=True)
        state = "stopped"
    print(f"  {full_svc}: {state} (rc={r.returncode})", file=sys.stderr)
ENFORCEEOF
# =========================================================================

echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) [post-refresh] completed successfully ==="

# Clear retained health topics of removed services so they disappear from Cumulocity.
# An empty retained payload deletes the retained message on the broker.
MQTT_PUB="$SNAP/usr/bin/mosquitto_pub"
MQTT_HOST="127.0.0.1"
MQTT_PORT="1883"
echo "Clearing stale service health topics..." >&2
for stale_svc in "tedge-log-plugin" "c8y-firmware-plugin" "tedge-file-log-plugin"; do
    "$MQTT_PUB" -h "$MQTT_HOST" -p "$MQTT_PORT" \
        -r -t "te/device/main/service/${stale_svc}/status/health" -m "" \
        2>/dev/null || true
done

# Re-connect snap interfaces after update
snapctl connect :hardware-observe 2>/dev/null || true
snapctl connect :log-observe 2>/dev/null || true
snapctl connect :snapd-control 2>/dev/null || true