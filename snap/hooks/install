#!/bin/bash
# thin-edge.io snap install hook
#
# Zuständig für install-spezifische Einmalaktionen:
#   1. Verzeichnisse anlegen
#   2. tedge init (Erstinitialisierung)
#   3. Erstmalige tedge-Defaults setzen
#   4. Gerätezertifikat erstellen
#   5. Snap-Interfaces verbinden
#
# Alles andere (Inventory, sm-plugin, Plugin-Configs) delegiert an den
# post-refresh Hook — so gibt es keine doppelte Logik.

set -e

echo "=== thin-edge.io snap install hook starting ===" >&2

# ── Verzeichnisse ────────────────────────────────────────────────────────────
mkdir -p "$SNAP_DATA/package-run"
chmod 777 "$SNAP_DATA/package-run"

mkdir -p "$SNAP_DATA/mosquitto" "$SNAP_COMMON/mosquitto" "$SNAP_DATA/mosquitto/persistence"
mkdir -p "$SNAP_DATA/tedge" "$SNAP_DATA/tedge/device-certs" "$SNAP_DATA/tedge/run"
mkdir -p "$SNAP_DATA/tedge/tmp" "$SNAP_DATA/tedge/sm-plugins" "$SNAP_DATA/tedge/log-plugins"
mkdir -p "$SNAP_DATA/tedge/plugins" "$SNAP_DATA/tedge/device" "$SNAP_DATA/tedge/.agent"
mkdir -p "$SNAP_COMMON/tedge/log" "$SNAP_COMMON/tedge/cache"

# Copy mosquitto base config
if [ -f "$SNAP/etc/mosquitto/mosquitto.conf" ]; then
    cp "$SNAP/etc/mosquitto/mosquitto.conf" "$SNAP_DATA/mosquitto/mosquitto.conf"
fi

# ── tedge Initialisierung ────────────────────────────────────────────────────
echo "Initializing tedge config directory at: $SNAP_DATA/tedge" >&2
export TEDGE_CONFIG_DIR="$SNAP_DATA/tedge"
if "$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" init 2>&1 | tee -a /tmp/tedge-init.log >&2; then
    echo "tedge init succeeded" >&2
else
    echo "WARNING: tedge init failed, but continuing..." >&2
fi

# ── Erstmalige tedge-Defaults (nur bei Neuinstallation relevant) ─────────────
echo "Setting tedge defaults..." >&2
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set device.type "ctrlX-CORE" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set software.plugin.default "snap" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set mqtt.bind.address "127.0.0.1" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set mqtt.bind.port "1883" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set mqtt.client.port "1883" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set http.bind.address "127.0.0.1" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set http.bind.port "8000" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set sudo.enable false || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set data.path "$SNAP_COMMON/tedge" || true
"$SNAP/bin/tedge" --config-dir "$SNAP_DATA/tedge" config set logs.path "$SNAP_COMMON/tedge/log" || true

# ── Gerätezertifikat erstellen ───────────────────────────────────────────────
echo "Auto-detecting device ID from system information..." >&2
if [ -f "$SNAP/scripts/manage-device-id.sh" ]; then
    "$SNAP/scripts/manage-device-id.sh" create 2>&1 | tee -a /tmp/tedge-cert.log >&2 || \
        echo "WARNING: Failed to create device certificate automatically" >&2
else
    echo "WARNING: Device ID management script not found" >&2
fi

# ── Snap-Interfaces verbinden ────────────────────────────────────────────────
echo "Connecting snap interfaces..." >&2
snapctl connect :hardware-observe 2>/dev/null && echo "hardware-observe connected" >&2 || true
snapctl connect :log-observe 2>/dev/null && echo "log-observe connected" >&2 || true

# ── Gemeinsame State-Initialisierung via post-refresh ────────────────────────
# Inventory, sm-plugin, Plugin-Configs und update-inventory.sh werden zentral
# vom post-refresh Hook verwaltet — kein doppelter Code.
echo "Delegating shared state setup to post-refresh hook..." >&2
bash "$SNAP/snap/hooks/post-refresh"

echo "Install hook completed successfully" >&2