#!/bin/bash
# thin-edge.io snap configure hook
# Handles configuration changes

set -eo pipefail

# ── Persistent hook log (SNAP_COMMON survives snap revisions, readable on device) ──
if [ -z "$_SNAP_HOOK_LOG_ACTIVE" ]; then
    _HOOK_LOG="${SNAP_COMMON}/tedge/log/snap-hooks.log"
    mkdir -p "$(dirname "$_HOOK_LOG")" 2>/dev/null || true
    exec > >(tee -a "$_HOOK_LOG") 2>&1
    export _SNAP_HOOK_LOG_ACTIVE=1
fi
echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) [configure] snap=${SNAP_NAME} version=${SNAP_VERSION} rev=${SNAP_REVISION} ==="

echo "=== thin-edge.io snap configure hook starting ===" >&2

# Ensure all directories exist (idempotent)
bash "$SNAP/scripts/setup-directories.sh"

# Ensure mosquitto config is up-to-date
if [ -f "$SNAP/etc/mosquitto/mosquitto.conf" ] && [ ! -f "$SNAP_DATA/mosquitto/mosquitto.conf" ]; then
    mkdir -p "$SNAP_DATA/mosquitto"
    cp "$SNAP/etc/mosquitto/mosquitto.conf" "$SNAP_DATA/mosquitto/mosquitto.conf"
fi

# Ensure symlink exists for lock directory
# Remove old directory or symlink (rmdir for empty dir, rm -rf as fallback)
if [ -d "$SNAP_DATA/tedge/run/lock" ] && [ ! -L "$SNAP_DATA/tedge/run/lock" ]; then
  rmdir "$SNAP_DATA/tedge/run/lock" 2>/dev/null || rm -rf "$SNAP_DATA/tedge/run/lock"
else
  rm -f "$SNAP_DATA/tedge/run/lock"
fi
ln -sf "$SNAP_COMMON/tedge/run/lock" "$SNAP_DATA/tedge/run/lock"

echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) [configure] completed successfully ==="
